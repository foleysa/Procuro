{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./test-fixtures": "./test/fixtures/factory.ts"
  },
  "scripts": {
    "push": "drizzle-kit push --config ./drizzle.config.ts",
    "push-force": "drizzle-kit push --force --config ./drizzle.config.ts",
    "sync": "node ./scripts/sync-schema.mjs",
    "postsync": "node ./scripts/post-sync-data-integrity.mjs",
    "backfill-s2p": "node ./scripts/backfill-s2p-fields.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "drizzle-zod": "^0.8.3",
    "pg": "^8.20.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.4.0",
    "@types/node": "catalog:",
    "@types/pg": "^8.20.0",
    "@vitest/coverage-v8": "^4.1.6",
    "drizzle-kit": "^0.31.10",
    "vitest": "^4.1.6"
  }
}
