{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development ALLOW_DEV_TENANT_HEADER=true && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "pretest": "pnpm --filter @workspace/db run sync",
    "test": "PG_POOL_MAX=${PG_POOL_MAX:-30} NODE_OPTIONS=--expose-gc node --experimental-test-module-mocks --import tsx --test test/*.test.ts",
    "test:usgs-live": "USGS_LIVE=1 node --import tsx --test --test-name-pattern='USGS DS-140 live URL probe' test/usgs-mineral.test.ts",
    "typecheck": "tsc -b ../../tsconfig.json && tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@clerk/express": "^2.1.10",
    "@clerk/shared": "^4.8.6",
    "@google/genai": "^1.50.1",
    "@swc/helpers": "^0.5.21",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/integrations-gemini-ai": "workspace:*",
    "@workspace/intelligence": "workspace:*",
    "busboy": "^1.6.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2",
    "cron-parser": "^5.5.0",
    "csv-parse": "^6.2.1",
    "drizzle-orm": "catalog:",
    "express": "^5",
    "http-proxy-middleware": "^3.0.5",
    "node-xlsx": "^0.24.0",
    "pdfkit": "^0.18.0",
    "pino": "^9",
    "pino-http": "^10",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.4",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/pdfkit": "^0.17.6",
    "esbuild": "^0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13",
    "thread-stream": "3.1.0",
    "tsx": "catalog:"
  }
}
